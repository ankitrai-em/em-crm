PORT=8787

# Set to "production" on the real server. Enables: hard failure at startup if JWT_SECRET is
# missing (instead of a warning + insecure fallback), and a startup warning if CORS_ORIGIN
# isn't set. Leave unset for local dev.
# NODE_ENV=production

# Signing secret for login sessions. REQUIRED in production (the app refuses to start
# without it once NODE_ENV=production) — generate one with `openssl rand -hex 32` and never
# commit the real value.
JWT_SECRET=

# Comma-separated list of frontend origin(s) allowed to call this API, e.g.
# https://crm.yourcompany.com. Required in production — left unset, the API accepts requests
# from any origin, which is fine for local dev but not once this has a real public URL.
# CORS_ORIGIN=https://crm.yourcompany.com

# Set this ONLY if the app is deployed behind a real reverse proxy (nginx, an AWS ALB, etc.)
# — it's the number of proxy hops in front of this process, usually 1. Needed for login rate
# limiting to see the real client IP instead of the proxy's. Leave unset if this process is
# not behind a proxy (e.g. running directly, or exposed straight to the internet).
# TRUST_PROXY=1

# Where uploaded invoice files are stored. Defaults to server/uploads if unset.
# Point this at a mounted volume in production (see server/README.md).
# UPLOADS_DIR=./uploads

# Where daily SQLite backups are written. Defaults to server/backups if unset. In production,
# this should be a path that's also synced offsite (see DEPLOYMENT.md) — a backup living on
# the same disk as the database it backs up doesn't survive that disk failing.
# BACKUP_DIR=./backups

# mock (default, no credentials needed) | sarv | twilio | exotel
# NOTE: in production, prefer setting the real provider + credentials from the app itself
# (log in as Admin -> Integrations) instead of here — that's stored in the database and
# rotatable without a redeploy or touching this file. These env vars are only the fallback
# used if nothing is configured in the app yet.
TELEPHONY_PROVIDER=mock

# --- Sarv / DeepCall (used when TELEPHONY_PROVIDER=sarv) ---
# SARV_USER_ID=
# SARV_TOKEN=

# --- Twilio (used when TELEPHONY_PROVIDER=twilio) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_TWIML_URL=

# --- Exotel (used when TELEPHONY_PROVIDER=exotel) ---
# EXOTEL_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_CALLER_ID=
# EXOTEL_AGENT_NUMBER=
# EXOTEL_SUBDOMAIN=api.exotel.com
